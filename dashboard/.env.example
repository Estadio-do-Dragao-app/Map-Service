# Dashboard standalone docker-compose environment
# Copy this to .env and fill in the values. Keep API_KEY in sync with the root .env
# and other services (especially mapservice) so authentication works.

# Shared API key - must match mapservice and dashboard-backend in the root compose
API_KEY=replace-with-a-real-api-key

# Frontend base URL for the standalone dashboard (default /api uses nginx proxy)
VITE_DASHBOARD_API_BASE=/api
